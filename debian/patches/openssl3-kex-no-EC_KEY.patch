Replace use of old APIs which are deprecated in OpenSSL 3

This patch updates key exchange logic to use EVP_PKEY instead
of the deprecated EC_KEY.

diff --git a/kex.c b/kex.c
index 6b957e5..0786ec6 100644
--- a/kex.c
+++ b/kex.c
@@ -724,7 +724,8 @@ kex_free(struct kex *kex)
 #ifdef WITH_OPENSSL
 	DH_free(kex->dh);
 #ifdef OPENSSL_HAS_ECC
-	EC_KEY_free(kex->ec_client_key);
+	EVP_PKEY_free(kex->ec_client_key);
+	EC_GROUP_free(kex->ec_group);
 #endif /* OPENSSL_HAS_ECC */
 #endif /* WITH_OPENSSL */
 	for (mode = 0; mode < MODE_MAX; mode++) {
