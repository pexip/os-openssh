-kex_ecdh_dec_key_group(struct kex *, const struct sshbuf *, EC_KEY *key,
+kex_ecdh_dec_key_group(struct kex *, const struct sshbuf *, EVP_PKEY *key,
     const EC_GROUP *, struct sshbuf **);
 
+static int
+kex_ecdh_keygen(int curve, EVP_PKEY **ppkey)
+{
+	EVP_PKEY_CTX *ctx = NULL;
+	EVP_PKEY *params = NULL;
+	EVP_PKEY *key = NULL;
+	int r;
+
+	if ((ctx = EVP_PKEY_CTX_new_id(EVP_PKEY_EC, NULL)) == NULL) {
+		r = SSH_ERR_ALLOC_FAIL;
+		goto out;
+	}
+	if (EVP_PKEY_paramgen_init(ctx) <= 0 ||
+	    EVP_PKEY_CTX_set_ec_paramgen_curve_nid(ctx, curve) <= 0 ||
+	    EVP_PKEY_CTX_set_ec_param_enc(ctx, OPENSSL_EC_NAMED_CURVE) <= 0 ||
+	    EVP_PKEY_paramgen(ctx, &params) <= 0) {
+		r = SSH_ERR_LIBCRYPTO_ERROR;
+		goto out;
+	}
+	EVP_PKEY_CTX_free(ctx);
+	ctx = NULL;
+	if ((ctx = EVP_PKEY_CTX_new(params, NULL)) == NULL) {
+		r = SSH_ERR_ALLOC_FAIL;
+		goto out;
+	}
+	if (EVP_PKEY_keygen_init(ctx) <= 0 ||
+	    EVP_PKEY_keygen(ctx, &key) <= 0) {
+		r = SSH_ERR_LIBCRYPTO_ERROR;
+		goto out;
+	}
+
+	*ppkey = key;
+	key = NULL;
+	r = 0;
+out:
+	EVP_PKEY_free(key);
+	EVP_PKEY_free(params);
+	EVP_PKEY_CTX_free(ctx);
+	return r;
+}
