 static int
+ssh_rsa_make_encoded_x509_pubkey(const BIGNUM *n, const BIGNUM *e,
+    u_char **penc, int *plen)
+{
+	rsapub p;
+	X509_PUBKEY *xp = NULL;
+	u_char *buf = NULL;
+	int len = 0;
+	int ret = SSH_ERR_INTERNAL_ERROR;
+
+	if ((xp = X509_PUBKEY_new()) == NULL) {
+		ret = SSH_ERR_LIBCRYPTO_ERROR;
+		goto out;
+	}
+
+	p.n = n;
+	p.e = e;
+
+	if ((len = i2d_rsapub(&p, &buf)) == 0) {
+		ret = SSH_ERR_LIBCRYPTO_ERROR;
+		goto out;
+	}
+	if (X509_PUBKEY_set0_param(xp, OBJ_nid2obj(EVP_PKEY_RSA), V_ASN1_NULL,
+	    NULL, buf, len) == 0) {
+		ret = SSH_ERR_LIBCRYPTO_ERROR;
+		goto out;
+	}
+	buf = NULL;
+
+	if ((len = i2d_X509_PUBKEY(xp, &buf)) == 0) {
+		ret = SSH_ERR_LIBCRYPTO_ERROR;
+		goto out;
+	}
+
+	*penc = buf;
+	*plen = len;
+	buf = NULL;
+	/* success */
+	ret = 0;
+out:
+	freezero(buf, len);
+	X509_PUBKEY_free(xp);
+	return ret;
+}
