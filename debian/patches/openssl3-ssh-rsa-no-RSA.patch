Replace use of old APIs which are deprecated in OpenSSL 3

This patch updates the sshkey utility.

Index: os-openssh/sshkey.h
===================================================================
--- os-openssh.orig/sshkey.h
+++ os-openssh/sshkey.h
@@ -34,6 +34,7 @@
 #include <openssl/dsa.h>
 #endif
 #include <openssl/evp.h>
+#include <openssl/x509.h>
 # ifdef OPENSSL_HAS_ECC
 #  include <openssl/ec.h>
 #  include <openssl/ecdsa.h>
@@ -54,6 +55,7 @@
 # define EC_GROUP	void
 # define EC_POINT	void
 # define EVP_PKEY	void
+# define PKCS8_PRIV_KEY_INFO void
 #define SSH_OPENSSL_VERSION "without OpenSSL"
 #endif /* WITH_OPENSSL */
 
@@ -328,6 +330,9 @@ int sshkey_check_rsa_length(const struct
 /* XXX should be internal, but used by ssh-keygen */
 int ssh_rsa_complete_crt_parameters(const BIGNUM *, const BIGNUM *,
     const BIGNUM *, const BIGNUM *, BIGNUM **, BIGNUM **);
+int ssh_rsa_make_pkcs8(const BIGNUM *n, const BIGNUM *e, const BIGNUM *d,
+    const BIGNUM *p, const BIGNUM *q, const BIGNUM *dmp1, const BIGNUM *dmq1,
+    const BIGNUM *iqmp, PKCS8_PRIV_KEY_INFO **ppkcs8);
 
 /* stateful keys (e.g. XMSS) */
 int	 sshkey_set_filename(struct sshkey *, const char *);
@@ -360,6 +365,7 @@ int	sshkey_private_deserialize_sk(struct
 # undef EC_GROUP
 # undef EC_POINT
 # undef EVP_PKEY
+# undef PKCS8_PRIV_KEY_INFO
 #else
 # if !defined(OPENSSL_HAS_ECC)
 #  undef EC_KEY
