+int
+ssh_rsa_make_pkcs8(const BIGNUM *n, const BIGNUM *e, const BIGNUM *d,
+    const BIGNUM *p, const BIGNUM *q, const BIGNUM *dmp1, const BIGNUM *dmq1,
+    const BIGNUM *iqmp, PKCS8_PRIV_KEY_INFO **ppkcs8)
+{
+	rsapriv priv;
+	PKCS8_PRIV_KEY_INFO *p8 = NULL;
+	u_char *buf = NULL;
+	int len = 0;
+	int r;
+
+	priv.version = 0;
+	priv.n = n;
+	priv.e = e;
+	priv.d = d;
+	priv.p = p;
+	priv.q = q;
+	priv.dmp1 = dmp1;
+	priv.dmq1 = dmq1;
+	priv.iqmp = iqmp;
+
+	if ((p8 = PKCS8_PRIV_KEY_INFO_new()) == NULL) {
+		r = SSH_ERR_ALLOC_FAIL;
+		goto out;
+	}
+
+	if ((len = i2d_rsapriv(&priv, &buf)) == 0) {
+		r = SSH_ERR_LIBCRYPTO_ERROR;
+		goto out;
+	}
+
+	if (PKCS8_pkey_set0(p8, OBJ_nid2obj(EVP_PKEY_RSA), 0,
+	    V_ASN1_NULL, NULL, buf, len) == 0) {
+		r = SSH_ERR_LIBCRYPTO_ERROR;
+		goto out;
+	}
+	buf = NULL;
+
+	*ppkcs8 = p8;
+	p8 = NULL;
+	/* success */
+	r = 0;
+out:
+	freezero(buf, len);
+	PKCS8_PRIV_KEY_INFO_free(p8);
+	return r;
+}
