Replace use of old APIs which are deprecated in OpenSSL 3

This patch updates the sshkey utility.

diff --git a/sshkey.h b/sshkey.h
index d0cdea0..7f6c72c 100644
--- a/sshkey.h
+++ b/sshkey.h
@@ -40,6 +40,9 @@
 #  define EC_GROUP	void
 #  define EC_POINT	void
 # endif /* OPENSSL_HAS_ECC */
+# ifndef WITH_DSA
+#  define DSA		void
+# endif /* WITH_DSA */
 #define SSH_OPENSSL_VERSION OpenSSL_version(OPENSSL_VERSION)
 #else /* WITH_OPENSSL */
 # define BIGNUM		void
@@ -344,9 +347,6 @@ int	sshkey_deserialize_sk(struct sshbuf *b, struct sshkey *key);
 int	sshkey_serialize_private_sk(const struct sshkey *key,
     struct sshbuf *buf);
 int	sshkey_private_deserialize_sk(struct sshbuf *buf, struct sshkey *k);
-#ifdef WITH_OPENSSL
-int	check_rsa_length(const RSA *rsa); /* XXX remove */
-#endif
 #endif
 
 #if !defined(WITH_OPENSSL)
@@ -356,10 +356,15 @@ int	check_rsa_length(const RSA *rsa); /* XXX remove */
 # undef EC_GROUP
 # undef EC_POINT
 # undef EVP_PKEY
-#elif !defined(OPENSSL_HAS_ECC)
-# undef EC_KEY
-# undef EC_GROUP
-# undef EC_POINT
+#else
+# if !defined(OPENSSL_HAS_ECC)
+#  undef EC_KEY
+#  undef EC_GROUP
+#  undef EC_POINT
+# endif
+# if !defined(WITH_DSA)
+#  undef DSA
+# endif
 #endif
 
 #endif /* SSHKEY_H */
