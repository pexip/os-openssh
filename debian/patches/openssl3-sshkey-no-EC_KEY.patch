Replace use of old APIs which are deprecated in OpenSSL 3

This patch updates the sshkey utility to avoid using deprecated EC_KEY
routines.

Index: os-openssh/ssh-ecdsa.c
===================================================================
--- os-openssh.orig/ssh-ecdsa.c
+++ os-openssh/ssh-ecdsa.c
@@ -302,7 +302,8 @@ ssh_ecdsa_deserialize_private(const char
 		r = SSH_ERR_LIBCRYPTO_ERROR;
 		goto out;
 	}
-	if ((r = sshkey_ec_validate_private(ec)) != 0)
+	if ((r = sshkey_ec_validate_private(EC_KEY_get0_group(ec),
+	    exponent)) != 0)
 		goto out;
 	if (EVP_PKEY_set1_EC_KEY(key->pkey, ec) != 1) {
 		r = SSH_ERR_LIBCRYPTO_ERROR;
