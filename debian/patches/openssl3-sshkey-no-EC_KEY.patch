+EC_POINT *
+sshkey_ec_public_as_point(const EVP_PKEY *k, const EC_GROUP *g)
+{
+	EC_POINT *ecp = NULL;
+	unsigned char *buf = NULL;
+	size_t len;
+
+	if ((len = EVP_PKEY_get1_encoded_public_key((EVP_PKEY *) k, &buf)) == 0 ||
+	    (ecp = EC_POINT_new(g)) == NULL ||
+	    EC_POINT_oct2point(g, ecp, buf, len, NULL) == 0)
+		goto err;
+	OPENSSL_free(buf);
+	return ecp;
+err:
+	EC_POINT_free(ecp);
+	OPENSSL_free(buf);
+	return NULL;
+}
+
+BIGNUM *
+sshkey_ec_private_as_bignum(const EVP_PKEY *k)
+{
+	BIGNUM *bn = NULL;
+
+	if (EVP_PKEY_get_bn_param(k, OSSL_PKEY_PARAM_PRIV_KEY, &bn) == 0)
+		bn = NULL;
+
+	return bn;
+}
