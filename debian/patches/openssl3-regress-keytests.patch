+
+	ASSERT_PTR_NE(k, NULL);
+	ASSERT_PTR_NE(k->pkey, NULL);
+	ASSERT_INT_EQ(EVP_PKEY_get_bn_param(k->pkey,
+	    OSSL_PKEY_PARAM_PRIV_KEY, &priv), 1);
+	r = BN_cmp(priv, exp);
+	BN_clear_free(priv);
+	return r == 0;
+}
