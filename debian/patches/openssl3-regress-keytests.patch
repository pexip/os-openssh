+
+int
+with_ec_pub_key(struct sshkey *k, const BIGNUM *exp)
+{
+	EC_GROUP *g = NULL;
+	EC_POINT *p = NULL;
+	BIGNUM *pub = NULL;
+	u_char *buf = NULL;
+	size_t len = 0;
+	int r;
+
+	ASSERT_PTR_NE(k, NULL);
+	ASSERT_PTR_NE(k->pkey, NULL);
+	g = EC_GROUP_new_by_curve_name(k->ecdsa_nid);
+	ASSERT_PTR_NE(g, NULL);
+	len = EVP_PKEY_get1_encoded_public_key(k->pkey, &buf);
+	ASSERT_INT_NE(len, 0);
+	p = EC_POINT_new(g);
+	ASSERT_PTR_NE(p, NULL);
+	ASSERT_INT_EQ(EC_POINT_oct2point(g, p, buf, len, NULL), 1);
+	freezero(buf, len);
+	buf = NULL;
+	ASSERT_PTR_NE(p, NULL);
+	len = EC_POINT_point2buf(g, p, POINT_CONVERSION_UNCOMPRESSED, &buf,
+	    NULL);
+	ASSERT_INT_NE(len, 0);
+	pub = BN_bin2bn(buf, len, NULL);
+	ASSERT_PTR_NE(pub, NULL);
+	r = BN_cmp(pub, exp);
+	BN_clear_free(pub);
+	freezero(buf, len);
+	EC_POINT_free(p);
+	EC_GROUP_free(g);
+	return r == 0;
+}
+
+int
+with_ec_priv_key(struct sshkey *k, const BIGNUM *exp)
+{
+	BIGNUM *priv = NULL;
